{
  "name": "@referalli/express",
  "version": "0.2.0",
  "description": "Express (and any Node http) middleware for Referalli: webhook signature verification with raw-body handling, and first-party referral attribution cookies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "referalli": "^0.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.9.0",
    "express": "^5.1.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "referalli",
    "express",
    "middleware",
    "webhooks",
    "referral",
    "affiliate",
    "attribution"
  ],
  "homepage": "https://referalli.com/docs/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Referalli/referalli-js.git",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/Referalli/referalli-js/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts"
}
