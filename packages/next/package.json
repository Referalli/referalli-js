{
  "name": "@referalli/next",
  "version": "0.1.1",
  "description": "Next.js kit for Referalli: middleware that captures ?ref= into a first-party cookie, getReferral() for server code, webhook route handlers and signup attribution.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/esm/middleware.d.ts",
        "default": "./dist/esm/middleware.js"
      },
      "require": {
        "types": "./dist/cjs/middleware.d.ts",
        "default": "./dist/cjs/middleware.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "referalli": "^0.1.1"
  },
  "peerDependencies": {
    "next": ">=13.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "referalli",
    "nextjs",
    "next",
    "middleware",
    "referral",
    "affiliate",
    "webhooks"
  ],
  "homepage": "https://referalli.com/docs/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Referalli/referalli-js.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/Referalli/referalli-js/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts"
}
