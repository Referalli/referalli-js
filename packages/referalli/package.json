{
  "name": "referalli",
  "version": "0.1.0",
  "description": "Official Referalli SDK for JavaScript and TypeScript: every API operation typed, webhooks, and the browser referral tracker.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./attribution": "./src/attribution.ts",
    "./types": "./src/generated.ts",
    "./codegen": "./src/codegen.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen": "node scripts/gen.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./browser": {
        "import": {
          "types": "./dist/esm/browser.d.ts",
          "default": "./dist/esm/browser.js"
        },
        "require": {
          "types": "./dist/cjs/browser.d.ts",
          "default": "./dist/cjs/browser.js"
        }
      },
      "./attribution": {
        "import": {
          "types": "./dist/esm/attribution.d.ts",
          "default": "./dist/esm/attribution.js"
        },
        "require": {
          "types": "./dist/cjs/attribution.d.ts",
          "default": "./dist/cjs/attribution.js"
        }
      },
      "./types": {
        "import": {
          "types": "./dist/esm/generated.d.ts",
          "default": "./dist/esm/generated.js"
        },
        "require": {
          "types": "./dist/cjs/generated.d.ts",
          "default": "./dist/cjs/generated.js"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "referalli",
    "referral",
    "affiliate",
    "attribution",
    "partner",
    "webhooks",
    "sdk"
  ],
  "homepage": "https://referalli.com/docs/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Referalli/referalli-js.git",
    "directory": "packages/referalli"
  },
  "bugs": {
    "url": "https://github.com/Referalli/referalli-js/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
